# Local Supabase credentials — printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Ollama — defaults to http://localhost:11434 if unset.
OLLAMA_BASE_URL=http://localhost:11434

# Optional: cap concurrent requests sent to your local Ollama instance.
MAX_CONCURRENT_OLLAMA_REQUESTS=
